{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Arcalabs",
  "version": "0.1.0",
  "identifier": "com.arcalabs.desktop",
  "build": {
    "beforeDevCommand": "pnpm --filter appsdesktop dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm --filter appsdesktop build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Arcalabs",
        "width": 1372,
        "height": 882,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": false,
        "backgroundColor": "#0F1013"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
